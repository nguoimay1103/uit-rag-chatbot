# ─── Environment Variables Template ─────────────────────────────────────────
# Sao chép file này thành .env và điền giá trị thật
# KHÔNG commit file .env lên Git!
# ────────────────────────────────────────────────────────────────────────────

# OpenAI
OPENAI_API_KEY=sk-proj-...

# Qdrant Cloud
QDRANT_URL=https://YOUR_CLUSTER_ID.us-east-1-1.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key

# Supabase (lấy từ Supabase Dashboard > Settings > API)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Supabase Anon Key (dùng ở frontend, public được)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# CORS — thêm Vercel domain của bạn
ALLOWED_ORIGINS=http://localhost:8501,https://your-app.vercel.app

# Reranker Strategy
# true  = Load BAAI model (local dev, cần ~1.5GB RAM)
# false = Qdrant Hybrid RRF (production Render free tier)
USE_RERANKER=true

# BM25 Path
BM25_PATH=data/processed/bm25_retriever.pkl
