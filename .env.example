# OpenAI
OPENAI_API_KEY=

# Qdrant Cloud
QDRANT_URL=https://YOUR_CLUSTER.cloud.qdrant.io
QDRANT_API_KEY=

# Supabase backend credentials. Never expose SERVICE_ROLE or JWT_SECRET in frontend code.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=

# Runtime
ALLOWED_ORIGINS=http://localhost:8501
USE_RERANKER=false
BM25_PATH=data/processed/bm25_retriever.pkl
RAG_CORPUS_VERSION=uit_admissions-v1

# Evaluation (optional)
EVAL_JUDGE_MODEL=gpt-4o-mini
EVAL_MAX_CONTEXT_CHARS=40000
